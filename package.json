{
  "name": "leetlife",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test --no-default-features",
    "bench": "cd src-tauri && CARGO_PROFILE_BENCH_DEBUG=false cargo bench --no-default-features",
    "test:rust:all": "cd src-tauri && cargo test",
    "check:rust": "cd src-tauri && cargo check --no-default-features --all-targets",
    "check:desktop": "cd src-tauri && cargo check --all-targets",
    "bench:profile": "cd src-tauri && cargo bench --no-default-features",
    "icons": "python3 scripts/gen_icns.py build",
    "start": "bash scripts/macos.sh run",
    "desktop": "bash scripts/macos.sh dev",
    "build:mac": "bash scripts/macos.sh build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
